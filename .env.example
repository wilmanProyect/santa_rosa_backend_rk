# Copiar a .env y ajustar. Lo usan tanto `pnpm start:dev` como `docker compose`.

PORT=3000
NODE_ENV=development

# PostgreSQL
# Para `pnpm start:dev` la BD es el contenedor expuesto en el host (localhost:5439).
# Dentro de docker compose, la API usa postgres:5432 automáticamente.
DB_HOST=localhost
DB_PORT=5439
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=santa_rosa_db
# Aplica las migraciones pendientes al arrancar la API.
DB_MIGRATIONS_RUN=true

# Puertos publicados en el host por docker compose
DB_EXTERNAL_PORT=5439
API_EXTERNAL_PORT=3000
GARAGE_S3_EXTERNAL_PORT=3900

# Autenticación (JWT). Genere un secreto con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15

# Usuario administrador inicial (solo se crea si no hay ningún administrador activo)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=Admin123

# Garage (almacenamiento de fotos y certificados, compatible con S3)
# Para `pnpm start:dev` es el contenedor expuesto en el host (localhost:3900).
# Dentro de docker compose, la API usa garage:3900 automáticamente.
S3_ENDPOINT=http://localhost:3900
# URL con la que el NAVEGADOR llega a Garage; se usa para firmar las URL de las fotos.
S3_PUBLIC_ENDPOINT=http://localhost:3900
# Debe coincidir con s3_region de docker/garage/garage.toml.
S3_REGION=garage
# Garage crea el bucket y la clave en su primer arranque.
S3_BUCKET=santa-rosa
# Validez de las URL temporales de las fotos, en segundos.
S3_PRESIGNED_URL_TTL_SECONDS=900

# Secretos de Garage (obligatorios). Garage exige este formato:
#   S3_ACCESS_KEY: "GK" + 24 caracteres hexadecimales
#   S3_SECRET_KEY, GARAGE_RPC_SECRET, GARAGE_ADMIN_TOKEN: 64 caracteres hexadecimales
# Genérelos con:
#   node -e "const h=n=>require('crypto').randomBytes(n).toString('hex');console.log('S3_ACCESS_KEY=GK'+h(12)+'\nS3_SECRET_KEY='+h(32)+'\nGARAGE_RPC_SECRET='+h(32)+'\nGARAGE_ADMIN_TOKEN='+h(32))"
# o, en Linux (sin Node):
#   echo "S3_ACCESS_KEY=GK$(openssl rand -hex 12)"; for v in S3_SECRET_KEY GARAGE_RPC_SECRET GARAGE_ADMIN_TOKEN; do echo "$v=$(openssl rand -hex 32)"; done
# Si cambia la clave S3, Garage registra la nueva al reiniciar, pero la anterior
# SIGUE con acceso al bucket. Revóquela con:
#   docker compose exec garage /garage key delete --yes <clave anterior>
# GARAGE_RPC_SECRET no debe cambiar una vez creados los volúmenes.
S3_ACCESS_KEY=GK44ffe0ac0f39cc9ed09a6562
S3_SECRET_KEY=dfcf729901a78847f0a29f7666588e43cb715ed1dc298612aeb2a70aa4484c41
GARAGE_RPC_SECRET=5b6a7f5361569a04a16293d080450f3522882a5c6f84462814e7d16ee62e685d
GARAGE_ADMIN_TOKEN=48058eec0e65d3225205d2ebc7f1c5fc569f912fc1ff3719c3207e7f71383e5d

# Orígenes del frontend autorizados (CORS), separados por coma.
CORS_ORIGINS=http://localhost:5173

# Datos impresos en el certificado del animal (PDF).
FARM_NAME=Cabaña Santa Rosa
FARM_CODE=28-A
# Criadores responsables, separados por coma (firman el certificado).
FARM_BREEDERS=Ricardo Limpias Mateff, Katlyn Los
FARM_LOCALITY=Portachuelo
FARM_PHONE=69405387
FARM_REGION=Santa Cruz - Bolivia
# Zona horaria de la fecha y hora de emisión.
FARM_TIME_ZONE=America/La_Paz
# true si la API está detrás de un proxy inverso (nginx, Traefik) para registrar la IP real.
TRUST_PROXY=false
